{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-named-as-default-member": "off"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["node_modules", "dist"]
}
