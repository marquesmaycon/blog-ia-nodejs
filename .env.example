API_HOST=localhost
API_PORT=8080
API_PROTOCOL=http
API_KEY=
# URL pública usada nos links do RSS; sem ela, usa API_PROTOCOL://API_HOST:API_PORT
SITE_URL=
# true só atrás de um proxy confiável: o rate limiting passa a usar o IP de X-Forwarded-For
TRUST_PROXY=false

POST_WRITER_MODEL=google/gemini-2.5-flash
COMMENT_MODERATOR_MODEL=google/gemini-2.5-flash
# Tempo máximo (ms) da moderação; ao estourar, o comentário fica pendente
COMMENT_MODERATION_TIMEOUT_MS=10000
POST_REVIEWER_MODEL=google/gemini-2.5-flash
# Revisão dos rascunhos: nota mínima (0-10) para aceitar e máximo de tentativas de escrita
POST_REVIEW_MIN_SCORE=7
POST_REVIEW_MAX_ATTEMPTS=3
# Tempo máximo (ms) de cada revisão; ao estourar, o rascunho é salvo sem ela
POST_REVIEW_TIMEOUT_MS=30000
POST_SEO_MODEL=google/gemini-2.5-flash
# Tempo máximo (ms) da geração de SEO; ao estourar, o rascunho é salvo sem os metadados
POST_SEO_TIMEOUT_MS=20000
GOOGLE_API_KEY=
GROQ_API_KEY=
DATABASE_URL=postgres://blog:blog@localhost:5432/blog
