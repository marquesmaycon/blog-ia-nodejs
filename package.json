{
  "name": "blog-ia-nodejs",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file=.env.local --watch src/index.ts",
    "env:setup": "node -e \"if (!fs.existsSync('.env.local')) fs.copyFileSync('.env.example', '.env.local')\"",
    "local:setup": "npm run env:setup && npm run infra:up && npm run migrate:up",
    "typecheck": "tsc",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "migrate:up": "postgrator",
    "migrate:down": "postgrator 0"
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "postgrator-cli": "^10.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mastra/core": "^1.83.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
